# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Database settings -> Connection string
# Use the pooled ("Transaction" mode, port 6543) URI for DATABASE_URL, with
# ?pgbouncer=true appended (required so Prisma skips prepared statements,
# which PgBouncer transaction mode doesn't support)
# Use the direct (port 5432) URI for DIRECT_URL (needed for migrations).
# If migrations fail with "Can't reach database server" on the true direct
# host (db.<ref>.supabase.co:5432), that's usually IPv6-only routing your
# network can't reach — use the "Session pooler" variant instead (same
# pooler host as DATABASE_URL, port 5432, no ?pgbouncer=true).
DATABASE_URL=postgresql://...pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://...pooler.supabase.com:5432/postgres

# Session cookie signing secret (any long random string)
SESSION_SECRET=
