# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Database settings -> Connection string
# Use the pooled ("Transaction" mode, port 6543) URI for DATABASE_URL
# Use the direct (port 5432) URI for DIRECT_URL (needed for migrations)
DATABASE_URL=
DIRECT_URL=

# Session cookie signing secret (any long random string)
SESSION_SECRET=
